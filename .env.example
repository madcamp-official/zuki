# === 서버 ===
PORT=4000
NODE_ENV=development

# === 데이터베이스 (Supabase PostgreSQL 연결 문자열) ===
# Supabase 프로젝트 설정 > Database > Connection string 에서 확인
DATABASE_URL=postgresql://user:password@localhost:5432/trendpick

# === 네이버 데이터랩 검색어트렌드 API ===
# 발급: https://developers.naver.com (애플리케이션 등록 후 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === 유튜브 데이터 API v3 ===
# 발급: Google Cloud Console (신용카드 불필요)
YOUTUBE_API_KEY=

# === 스코어링 가중치 (기획서 11-5, 초기값은 팀 합의 후 조정) ===
SCORE_WEIGHT_NAVER=0.5
SCORE_WEIGHT_YOUTUBE=0.3
SCORE_WEIGHT_EDITOR=0.2

# === 배치 스케줄 (node-cron 표현식, 기본: 매일 새벽 3시) ===
DAILY_COLLECT_CRON=0 3 * * *
