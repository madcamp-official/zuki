# !!! 이 파일은 git에 커밋되는 템플릿입니다 !!!
# 실제 키/비밀번호는 여기 넣지 마세요. backend/.env 파일에 넣으세요.
# (처음 세팅: backend 폴더에서 `copy ..\.env.example .env` 실행 후 backend/.env를 수정)

# === 서버 ===
PORT=4000
NODE_ENV=development

# 허용할 프론트엔드 도메인 (쉼표로 여러 개). 비워두면 전체 허용.
# 로컬 개발은 비워두면 되고, 배포 시 프론트 도메인을 넣어 좁힌다.
# 예: CORS_ORIGIN=https://trendpick.vercel.app
CORS_ORIGIN=

# === 데이터베이스 (Supabase PostgreSQL 연결 문자열) ===
# Supabase 프로젝트 설정 > Database > Connection string 에서 확인
DATABASE_URL=postgresql://user:password@localhost:5432/trendpick

# === 네이버 데이터랩 검색어트렌드 API ===
# 발급: https://developers.naver.com (애플리케이션 등록 후 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === 유튜브 데이터 API v3 ===
# 발급: Google Cloud Console (신용카드 불필요)
YOUTUBE_API_KEY=

# === 스코어링 가중치 (기획서 11-5, 초기값은 팀 합의 후 조정) ===
SCORE_WEIGHT_NAVER=0.5
SCORE_WEIGHT_YOUTUBE=0.3
SCORE_WEIGHT_EDITOR=0.2

# === 배치 스케줄 (node-cron 표현식, 기본: 매일 새벽 3시) ===
# 서버 프로세스가 살아있을 때만 동작함. 배포 환경(Render 무료)은 슬립되므로
# 외부 스케줄러가 POST /api/admin/collect 를 호출하는 방식을 함께 쓴다.
DAILY_COLLECT_CRON=0 3 * * *

# 수집 실행 API 보호용 비밀키.
# 설정하면 POST /api/admin/collect 호출 시 x-collect-secret 헤더가 일치해야 함.
# 비워두면 누구나 호출 가능 (로컬 개발용). 배포 환경에서는 반드시 채울 것.
COLLECT_SECRET=
