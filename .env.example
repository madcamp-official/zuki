# !!! 이 파일은 git에 커밋되는 템플릿입니다 !!!
# 실제 키/비밀번호는 여기 넣지 마세요. backend/.env 파일에 넣으세요.
# (처음 세팅: backend 폴더에서 `copy ..\.env.example .env` 실행 후 backend/.env를 수정)

# === 서버 ===
PORT=4000
NODE_ENV=development

# 허용할 프론트엔드 도메인 (쉼표로 여러 개). 비워두면 전체 허용.
# 로컬 개발은 비워두면 되고, 배포 시 프론트 도메인을 넣어 좁힌다.
# 예: CORS_ORIGIN=https://trendpick.vercel.app
CORS_ORIGIN=

# === 데이터베이스 (Supabase PostgreSQL 연결 문자열) ===
# Supabase 프로젝트 설정 > Database > Connection string 에서 확인
DATABASE_URL=postgresql://user:password@localhost:5432/trendpick

# === Supabase Auth ===
# 프로젝트 URL. JWT 검증용 공개키(JWKS)를 여기서 가져온다.
SUPABASE_URL=https://프로젝트ID.supabase.co
# 공개용 키 (브라우저에 노출돼도 안전). Settings > API Keys 에서 확인
SUPABASE_ANON_KEY=
# HS256(구 방식) 프로젝트만 필요. 비대칭 키(ES256/RS256)를 쓰면 비워둘 것
SUPABASE_JWT_SECRET=

# === Supabase Storage (AI 생성 이미지 저장) ===
# service_role 키. RLS를 우회하는 최고 권한이므로 절대 브라우저에 노출하지 말 것.
# Settings > API Keys > service_role 에서 확인
# 없으면 이미지를 로컬 파일로 저장하는데, 배포 환경에서는 서빙되지 않는다.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=trend-images

# === OpenAI (트렌드 카드 이미지·문구 자동 생성) ===
OPENAI_API_KEY=
# 문구 생성 모델 (기본 gpt-4o-mini). 카드 10개에 1센트 미만이라 사실상 무료
OPENAI_TEXT_MODEL=gpt-4o-mini
# 이미지 모델. 장당 비용(1024x1024, medium):
#   gpt-image-1       $0.042  (2026-10-23 지원 종료 예정)
#   gpt-image-1.5     $0.034
#   gpt-image-1-mini  $0.011  <- 가장 저렴
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_QUALITY=medium

# === 네이버 데이터랩 검색어트렌드 API ===
# 발급: https://developers.naver.com (애플리케이션 등록 후 발급)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# === 유튜브 데이터 API v3 ===
# 발급: Google Cloud Console (신용카드 불필요)
YOUTUBE_API_KEY=

# === 수집 상한 ===
# 네이버: 호출당 5개 x 하루 1,000회 = 이론상 5,000개까지 가능
NAVER_KEYWORD_LIMIT=500
# 유튜브: 키워드당 101 unit. 하루 예산 = 수집 60개(6,060) + 발굴 2회(1,010) + 여유(2,930)
YOUTUBE_KEYWORD_LIMIT=60

# === 자동 파이프라인 스케줄 (node-cron 표현식, 시간대는 Asia/Seoul 고정) ===
#
# 서버 프로세스가 깨어 있을 때만 동작한다. Render 무료 플랜은 15분 무요청 시
# 슬립되므로, 외부에서 GET /health 를 10분마다 쳐서 깨워둬야 의미가 있다.
# (cron-job.org 무료로 충분하고, 할당량을 전혀 쓰지 않는다)
#
# 주기를 셋으로 나눈 이유는 소스별 할당량이 다르기 때문:
#   네이버 검색  25,000회/일  발굴 1회당 42회    -> 2시간마다 돌려도 하루 504회 (2%)
#   유튜브       10,000unit/일 발굴 1회당 505unit -> 하루 4회로 제한 (2,020unit, 20%)
#   데이터랩      1,000회/일   수집에서만 사용    -> 전체 실행 하루 1회

# 가벼운 발굴 — 네이버 블로그·카페만
DISCOVER_CRON=0 */2 * * *
# 유튜브 포함 발굴 (하루 2회 = 1,010 unit)
DISCOVER_YOUTUBE_CRON=30 9,20 * * *

# 네이버 검색 API 호출 간격(ms). 하루 한도와 별개로 초당 제한이 있어 필요하다.
# 너무 낮추면 429(errorCode 012)가 나고, 너무 높이면 발굴이 느려진다.
NAVER_SEARCH_INTERVAL_MS=120
# 전체 실행 — 발굴 + 수집 + 카드 갱신
PIPELINE_CRON=0 4 * * *
# true로 두면 위 스케줄을 아예 등록하지 않는다 (로컬에서 할당량 아낄 때)
DISABLE_PIPELINE_CRON=

# 수집·파이프라인 실행 API 보호용 비밀키.
# 설정하면 POST /api/admin/collect 와 POST /api/admin/pipeline 호출 시
# x-collect-secret 헤더가 일치해야 함.
# 비워두면 누구나 호출 가능 (로컬 개발용). 배포 환경에서는 반드시 채울 것.
COLLECT_SECRET=

# 관리자 API(/api/admin/*) 인증 우회. 로컬 개발 전용.
# true로 두면 로그인 없이 트렌드 등록·발굴이 가능하지만,
# 트렌드 등록 시 OpenAI 이미지 생성이 돌아 실제 비용이 나가므로
# 배포 환경에서는 절대 켜지 말 것.
ADMIN_AUTH_DISABLED=false
